# Fog Light: Fog in daylight: cool grey-blue paper with muted ink accents that rely on lightness steps.
# Generated by colorscheme-tools v0.1.0 from fog-light/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-fog-light
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-fog-light"]
	light = "true"
	plus-style = "syntax #b4c1d1"
	minus-style = "syntax #d4cac0"
	plus-emph-style = "syntax #849ab7"
	minus-emph-style = "syntax #c2ad94"
	zero-style = "syntax"
	file-style = "#497ab1 bold"
	file-decoration-style = "#bfc3c8 ul"
	hunk-header-style = "file line-number syntax #d9dcdf"
	hunk-header-decoration-style = "#bfc3c8 box"
	hunk-header-line-number-style = "#8e5277"
	line-numbers-minus-style = "#976826"
	line-numbers-plus-style = "#164276"
	line-numbers-zero-style = "#a6acb3"
	line-numbers-left-style = "#a6acb3"
	line-numbers-right-style = "#a6acb3"
	commit-decoration-style = "#31407b box"
	blame-palette = "#dde0e4 #d7dade #d0d3d7 #cacdd1"
	merge-conflict-ours-diff-header-style = "#164276 bold"
	merge-conflict-ours-diff-header-decoration-style = "#164276 box"
	merge-conflict-theirs-diff-header-style = "#956989 bold"
	merge-conflict-theirs-diff-header-decoration-style = "#956989 box"
