# Dusk: Dusky violet with soft rose, gold, teal and lavender accents.
# Generated by colorscheme-tools v0.1.0 from dusk/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-dusk
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-dusk"]
	dark = "true"
	plus-style = "syntax #283548"
	minus-style = "syntax #493e3e"
	plus-emph-style = "syntax #2c4f67"
	minus-emph-style = "syntax #786250"
	zero-style = "syntax"
	file-style = "#fec8be bold"
	file-decoration-style = "#3e3a4d ul"
	hunk-header-style = "file line-number syntax #292635"
	hunk-header-decoration-style = "#3e3a4d box"
	hunk-header-line-number-style = "#c9a7ff"
	line-numbers-minus-style = "#f6c177"
	line-numbers-plus-style = "#1e91b9"
	line-numbers-zero-style = "#59536d"
	line-numbers-left-style = "#59536d"
	line-numbers-right-style = "#59536d"
	commit-decoration-style = "#4988e2 box"
	blame-palette = "#262331 #2b2836 #302d3b #353241"
	merge-conflict-ours-diff-header-style = "#1e91b9 bold"
	merge-conflict-ours-diff-header-decoration-style = "#1e91b9 box"
	merge-conflict-theirs-diff-header-style = "#dfcefd bold"
	merge-conflict-theirs-diff-header-decoration-style = "#dfcefd box"
