{
  "schema_version": 2,
  "id": "dusk",
  "name": "Dusk",
  "variant": "dark",
  "family": "dusk",
  "description": "Dusky violet with soft rose, gold, teal and lavender accents.",
  "tags": [
    "dark",
    "soft",
    "violet"
  ],
  "designed_for": {
    "vision": "deutan",
    "severity": 1.0,
    "metric": "CIEDE2000 on simulated colours"
  },
  "palette": {
    "bg": "#211e2c",
    "bg_alt": "#2a2638",
    "fg": "#dcd6ea",
    "fg_dim": "#9d97b5",
    "comment": "#7a7393",
    "blue_light": "#4988e2",
    "red_light": "#fec8be",
    "amber_1": "#fdb843",
    "teal_2": "#88a69e",
    "purple_dark": "#c9a7ff",
    "violet_2": "#bcb8d4",
    "rose": "#d46483",
    "amber_4": "#fdc67b",
    "cyan": "#a3d5dd",
    "violet_1": "#a085e8",
    "sky": "#1e91b9",
    "purple_light": "#dfcefd",
    "amber_2": "#f6c177",
    "pink": "#c9659c",
    "green": "#189a55",
    "amber_3": "#fec269",
    "blue_dark": "#4486e6",
    "violet_3": "#cbb9ff",
    "teal_3": "#92edd2",
    "red_dark": "#ec6b7e",
    "teal_1": "#1ea08c",
    "yellow": "#ffe050",
    "indigo": "#558ef1",
    "violet_4": "#cbc9ff",
    "teal_4": "#9cffe2"
  },
  "roles": {
    "ui": {
      "bg": "bg",
      "bg_alt": "bg_alt",
      "fg": "fg",
      "fg_dim": "fg_dim",
      "comment": "comment"
    },
    "syntax": {
      "variable": {
        "fg": "ui.fg"
      },
      "comment": {
        "fg": "ui.comment",
        "italic": true
      },
      "keyword": {
        "fg": "blue_light",
        "italic": true
      },
      "function": {
        "fg": "red_light"
      },
      "string": {
        "fg": "amber_1"
      },
      "type": {
        "fg": "teal_2"
      },
      "constant": {
        "fg": "purple_dark"
      },
      "number": {
        "fg": "syntax.constant"
      },
      "boolean": {
        "fg": "syntax.constant"
      },
      "property": {
        "fg": "violet_2"
      },
      "parameter": {
        "fg": "ui.fg",
        "italic": true
      },
      "builtin": {
        "fg": "syntax.constant",
        "italic": true
      },
      "operator": {
        "fg": "ui.fg_dim"
      },
      "punctuation": {
        "fg": "ui.fg_dim"
      },
      "module": {
        "fg": "syntax.type",
        "italic": true
      },
      "attribute": {
        "fg": "syntax.keyword"
      },
      "tag": {
        "fg": "syntax.keyword"
      },
      "escape": {
        "fg": "syntax.constant"
      },
      "regex": {
        "fg": "syntax.constant"
      },
      "macro": {
        "fg": "syntax.keyword"
      },
      "constructor": {
        "fg": "syntax.type"
      },
      "label": {
        "fg": "syntax.keyword"
      },
      "todo": {
        "fg": "ui.bg",
        "bg": "diagnostic.warning",
        "bold": true
      },
      "note": {
        "fg": "ui.bg",
        "bg": "diagnostic.info",
        "bold": true
      }
    },
    "diagnostic": {
      "error": "rose",
      "warning": "amber_4",
      "info": "cyan",
      "hint": "violet_1",
      "ok": "git.add"
    },
    "git": {
      "add": "sky",
      "change": "purple_light",
      "delete": "amber_2"
    }
  },
  "terminal": {
    "background": "bg",
    "foreground": "fg",
    "cursor": "fg",
    "cursor_text": "bg",
    "selection_background": "bg_visual",
    "selection_foreground": "fg",
    "normal": {
      "black": {
        "raise": [
          "bg_alt",
          0.06
        ]
      },
      "red": "pink",
      "green": "green",
      "yellow": "amber_3",
      "blue": "blue_dark",
      "magenta": "violet_3",
      "cyan": "teal_3",
      "white": "fg"
    },
    "bright": {
      "black": "comment",
      "red": "red_dark",
      "green": "teal_1",
      "yellow": "yellow",
      "blue": "indigo",
      "magenta": "violet_4",
      "cyan": "teal_4",
      "white": {
        "raise": [
          "fg",
          0.07
        ]
      }
    }
  }
}
