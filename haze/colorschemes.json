{
  "schema_version": 2,
  "id": "haze",
  "name": "Haze",
  "variant": "dark",
  "family": "haze",
  "description": "Soft, slightly warm grey with dusty accents. The lowest-contrast scheme of the set.",
  "tags": [
    "dark",
    "muted",
    "low-contrast",
    "warm-grey"
  ],
  "designed_for": {
    "vision": "deutan",
    "severity": 1.0,
    "metric": "CIEDE2000 on simulated colours"
  },
  "palette": {
    "bg": "#2d2f33",
    "bg_alt": "#35373c",
    "fg": "#c0bdb5",
    "fg_dim": "#94928c",
    "comment": "#74736f",
    "indigo_dark": "#7b81b9",
    "blue_pale": "#9ecfff",
    "yellow_deep": "#e2c88a",
    "green": "#739b69",
    "magenta_dark": "#bb8cab",
    "grey": "#afa792",
    "orange": "#a47c63",
    "yellow_light": "#f4da9b",
    "blue_light": "#6f99c9",
    "cyan": "#aacec9",
    "blue_dark": "#6686b9",
    "magenta_light": "#ddc0d8",
    "amber_light": "#d0a771",
    "amber_dark": "#b17844",
    "teal_light": "#97e2cd",
    "yellow_dark": "#f1cc83",
    "blue_deep": "#5e86c1",
    "purple_dark": "#d1b8ff",
    "teal_deep": "#48917e",
    "amber": "#b58545",
    "teal_pale": "#a0f6d9",
    "yellow_pale": "#fedd92",
    "indigo_light": "#728ccc",
    "purple_light": "#dec5ff",
    "teal_dark": "#529b87"
  },
  "roles": {
    "ui": {
      "bg": "bg",
      "bg_alt": "bg_alt",
      "fg": "fg",
      "fg_dim": "fg_dim",
      "comment": "comment"
    },
    "syntax": {
      "variable": {
        "fg": "ui.fg"
      },
      "comment": {
        "fg": "ui.comment",
        "italic": true
      },
      "keyword": {
        "fg": "indigo_dark",
        "italic": true
      },
      "function": {
        "fg": "blue_pale"
      },
      "string": {
        "fg": "yellow_deep"
      },
      "type": {
        "fg": "green"
      },
      "constant": {
        "fg": "magenta_dark"
      },
      "number": {
        "fg": "syntax.constant"
      },
      "boolean": {
        "fg": "syntax.constant"
      },
      "property": {
        "fg": "grey"
      },
      "parameter": {
        "fg": "ui.fg",
        "italic": true
      },
      "builtin": {
        "fg": "syntax.constant",
        "italic": true
      },
      "operator": {
        "fg": "ui.fg_dim"
      },
      "punctuation": {
        "fg": "ui.fg_dim"
      },
      "module": {
        "fg": "syntax.type",
        "italic": true
      },
      "attribute": {
        "fg": "syntax.keyword"
      },
      "tag": {
        "fg": "syntax.keyword"
      },
      "escape": {
        "fg": "syntax.constant"
      },
      "regex": {
        "fg": "syntax.constant"
      },
      "macro": {
        "fg": "syntax.keyword"
      },
      "constructor": {
        "fg": "syntax.type"
      },
      "label": {
        "fg": "syntax.keyword"
      },
      "todo": {
        "fg": "ui.bg",
        "bg": "diagnostic.warning",
        "bold": true
      },
      "note": {
        "fg": "ui.bg",
        "bg": "diagnostic.info",
        "bold": true
      }
    },
    "diagnostic": {
      "error": "orange",
      "warning": "yellow_light",
      "info": "blue_light",
      "hint": "cyan",
      "ok": "git.add"
    },
    "git": {
      "add": "blue_dark",
      "change": "magenta_light",
      "delete": "amber_light"
    }
  },
  "terminal": {
    "background": "bg",
    "foreground": "fg",
    "cursor": "fg",
    "cursor_text": "bg",
    "selection_background": "bg_visual",
    "selection_foreground": "fg",
    "normal": {
      "black": {
        "raise": [
          "bg_alt",
          0.06
        ]
      },
      "red": "amber_dark",
      "green": "teal_light",
      "yellow": "yellow_dark",
      "blue": "blue_deep",
      "magenta": "purple_dark",
      "cyan": "teal_deep",
      "white": "fg"
    },
    "bright": {
      "black": "comment",
      "red": "amber",
      "green": "teal_pale",
      "yellow": "yellow_pale",
      "blue": "indigo_light",
      "magenta": "purple_light",
      "cyan": "teal_dark",
      "white": {
        "raise": [
          "fg",
          0.07
        ]
      }
    }
  }
}
