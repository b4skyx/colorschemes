# Haze: Soft, slightly warm grey with dusty accents. The lowest-contrast scheme of the set.
# Generated by colorscheme-tools v0.1.0 from haze/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-haze
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-haze"]
	dark = "true"
	plus-style = "syntax #39414e"
	minus-style = "syntax #4d4741"
	plus-emph-style = "syntax #46556c"
	minus-emph-style = "syntax #726250"
	zero-style = "syntax"
	file-style = "#9ecfff bold"
	file-decoration-style = "#4a4c51 ul"
	hunk-header-style = "file line-number syntax #36383c"
	hunk-header-decoration-style = "#4a4c51 box"
	hunk-header-line-number-style = "#bb8cab"
	line-numbers-minus-style = "#d0a771"
	line-numbers-plus-style = "#6686b9"
	line-numbers-zero-style = "#5a5a59"
	line-numbers-left-style = "#5a5a59"
	line-numbers-right-style = "#5a5a59"
	commit-decoration-style = "#7b81b9 box"
	blame-palette = "#323438 #37393d #3c3e43 #414448"
	merge-conflict-ours-diff-header-style = "#6686b9 bold"
	merge-conflict-ours-diff-header-decoration-style = "#6686b9 box"
	merge-conflict-theirs-diff-header-style = "#ddc0d8 bold"
	merge-conflict-theirs-diff-header-decoration-style = "#ddc0d8 box"
