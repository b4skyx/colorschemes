# Fog: Muted, low-contrast grey-blue with pastel accents that rely on lightness steps more than saturation.
# Generated by colorscheme-tools v0.1.0 from fog/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-fog
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-fog"]
	dark = "true"
	plus-style = "syntax #353e4a"
	minus-style = "syntax #4b4540"
	plus-emph-style = "syntax #415266"
	minus-emph-style = "syntax #6f6150"
	zero-style = "syntax"
	file-style = "#9ed1fc bold"
	file-decoration-style = "#46484d ul"
	hunk-header-style = "file line-number syntax #333539"
	hunk-header-decoration-style = "#46484d box"
	hunk-header-line-number-style = "#fdb9c4"
	line-numbers-minus-style = "#cfa976"
	line-numbers-plus-style = "#5e84b0"
	line-numbers-zero-style = "#54585f"
	line-numbers-left-style = "#54585f"
	line-numbers-right-style = "#54585f"
	commit-decoration-style = "#848cc2 box"
	blame-palette = "#2f3135 #34363a #393b3f #3e4045"
	merge-conflict-ours-diff-header-style = "#5e84b0 bold"
	merge-conflict-ours-diff-header-decoration-style = "#5e84b0 box"
	merge-conflict-theirs-diff-header-style = "#d9c2dc bold"
	merge-conflict-theirs-diff-header-decoration-style = "#d9c2dc box"
