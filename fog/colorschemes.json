{
  "schema_version": 2,
  "id": "fog",
  "name": "Fog",
  "variant": "dark",
  "family": "fog",
  "description": "Muted, low-contrast grey-blue with pastel accents that rely on lightness steps more than saturation.",
  "tags": [
    "dark",
    "muted",
    "low-contrast",
    "cool-grey"
  ],
  "designed_for": {
    "vision": "deutan",
    "severity": 1.0,
    "metric": "CIEDE2000 on simulated colours"
  },
  "palette": {
    "bg": "#2a2c30",
    "bg_alt": "#313338",
    "fg": "#b4b8bf",
    "fg_dim": "#8c9199",
    "comment": "#6d727a",
    "indigo": "#848cc2",
    "blue_6": "#9ed1fc",
    "yellow_1": "#cdb87d",
    "green": "#6d9673",
    "rose_light": "#fdb9c4",
    "blue_5": "#98afc4",
    "red": "#a17779",
    "yellow_2": "#dec88d",
    "blue_4": "#6991be",
    "cyan": "#b1d2d2",
    "blue_1": "#5e84b0",
    "magenta": "#d9c2dc",
    "amber": "#cfa976",
    "rose_dark": "#ab738a",
    "lime_dark": "#80863a",
    "yellow_3": "#e8ce81",
    "blue_2": "#5983bd",
    "purple": "#dcbbff",
    "teal_dark": "#b3ddc9",
    "rose": "#b77b90",
    "lime_light": "#889045",
    "yellow_4": "#fedc91",
    "blue_3": "#608dc7",
    "violet": "#d9cdff",
    "teal_light": "#c2edd8"
  },
  "roles": {
    "ui": {
      "bg": "bg",
      "bg_alt": "bg_alt",
      "fg": "fg",
      "fg_dim": "fg_dim",
      "comment": "comment"
    },
    "syntax": {
      "variable": {
        "fg": "ui.fg"
      },
      "comment": {
        "fg": "ui.comment",
        "italic": true
      },
      "keyword": {
        "fg": "indigo",
        "italic": true
      },
      "function": {
        "fg": "blue_6"
      },
      "string": {
        "fg": "yellow_1"
      },
      "type": {
        "fg": "green"
      },
      "constant": {
        "fg": "rose_light"
      },
      "number": {
        "fg": "syntax.constant"
      },
      "boolean": {
        "fg": "syntax.constant"
      },
      "property": {
        "fg": "blue_5"
      },
      "parameter": {
        "fg": "ui.fg",
        "italic": true
      },
      "builtin": {
        "fg": "syntax.constant",
        "italic": true
      },
      "operator": {
        "fg": "ui.fg_dim"
      },
      "punctuation": {
        "fg": "ui.fg_dim"
      },
      "module": {
        "fg": "syntax.type",
        "italic": true
      },
      "attribute": {
        "fg": "syntax.keyword"
      },
      "tag": {
        "fg": "syntax.keyword"
      },
      "escape": {
        "fg": "syntax.constant"
      },
      "regex": {
        "fg": "syntax.constant"
      },
      "macro": {
        "fg": "syntax.keyword"
      },
      "constructor": {
        "fg": "syntax.type"
      },
      "label": {
        "fg": "syntax.keyword"
      },
      "todo": {
        "fg": "ui.bg",
        "bg": "diagnostic.warning",
        "bold": true
      },
      "note": {
        "fg": "ui.bg",
        "bg": "diagnostic.info",
        "bold": true
      }
    },
    "diagnostic": {
      "error": "red",
      "warning": "yellow_2",
      "info": "blue_4",
      "hint": "cyan",
      "ok": "git.add"
    },
    "git": {
      "add": "blue_1",
      "change": "magenta",
      "delete": "amber"
    }
  },
  "terminal": {
    "background": "bg",
    "foreground": "fg",
    "cursor": "fg",
    "cursor_text": "bg",
    "selection_background": "bg_visual",
    "selection_foreground": "fg",
    "normal": {
      "black": {
        "raise": [
          "bg_alt",
          0.06
        ]
      },
      "red": "rose_dark",
      "green": "lime_dark",
      "yellow": "yellow_3",
      "blue": "blue_2",
      "magenta": "purple",
      "cyan": "teal_dark",
      "white": "fg"
    },
    "bright": {
      "black": "comment",
      "red": "rose",
      "green": "lime_light",
      "yellow": "yellow_4",
      "blue": "blue_3",
      "magenta": "violet",
      "cyan": "teal_light",
      "white": {
        "raise": [
          "fg",
          0.07
        ]
      }
    }
  }
}
