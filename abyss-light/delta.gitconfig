# Abyss Light: Crisp near-white with clear, saturated ink colours for maximum clarity.
# Generated by colorscheme-tools v0.1.0 from abyss-light/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-abyss-light
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-abyss-light"]
	light = "true"
	plus-style = "syntax #c0ccd8"
	minus-style = "syntax #e4d5c8"
	plus-emph-style = "syntax #8aa1b7"
	minus-emph-style = "syntax #d1b295"
	zero-style = "syntax"
	file-style = "#0972d2 bold"
	file-decoration-style = "#d0d3d7 ul"
	hunk-header-style = "file line-number syntax #eaebed"
	hunk-header-decoration-style = "#d0d3d7 box"
	hunk-header-line-number-style = "#8c2369"
	line-numbers-minus-style = "#a06002"
	line-numbers-plus-style = "#083f68"
	line-numbers-zero-style = "#a4a9b2"
	line-numbers-left-style = "#a4a9b2"
	line-numbers-right-style = "#a4a9b2"
	commit-decoration-style = "#072f94 box"
	blame-palette = "#eff0f2 #e9eaec #e2e3e5 #dcddde"
	merge-conflict-ours-diff-header-style = "#083f68 bold"
	merge-conflict-ours-diff-header-decoration-style = "#083f68 box"
	merge-conflict-theirs-diff-header-style = "#8a59c9 bold"
	merge-conflict-theirs-diff-header-decoration-style = "#8a59c9 box"
