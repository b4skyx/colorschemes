# Haze Light: Haze on warm paper: soft, low-contrast light grey with dusty ink accents.
# Generated by colorscheme-tools v0.1.0 from haze-light/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-haze-light
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-haze-light"]
	light = "true"
	plus-style = "syntax #b9bfc8"
	minus-style = "syntax #d7c9b5"
	plus-emph-style = "syntax #8a98b1"
	minus-emph-style = "syntax #c5ad8b"
	zero-style = "syntax"
	file-style = "#3f78b0 bold"
	file-decoration-style = "#c4c0b8 ul"
	hunk-header-style = "file line-number syntax #dcdad3"
	hunk-header-decoration-style = "#c4c0b8 box"
	hunk-header-line-number-style = "#8d5577"
	line-numbers-minus-style = "#9a6a1a"
	line-numbers-plus-style = "#243f77"
	line-numbers-zero-style = "#aba8a0"
	line-numbers-left-style = "#aba8a0"
	line-numbers-right-style = "#aba8a0"
	commit-decoration-style = "#2e3d77 box"
	blame-palette = "#e1ded7 #dbd8d1 #d4d1cb #cecbc4"
	merge-conflict-ours-diff-header-style = "#243f77 bold"
	merge-conflict-ours-diff-header-decoration-style = "#243f77 box"
	merge-conflict-theirs-diff-header-style = "#98678a bold"
	merge-conflict-theirs-diff-header-decoration-style = "#98678a box"
