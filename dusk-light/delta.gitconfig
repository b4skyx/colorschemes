# Dusk Light: Dusk on rose-tinted paper with teal, gold and lavender inks.
# Generated by colorscheme-tools v0.1.0 from dusk-light/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-dusk-light
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-dusk-light"]
	light = "true"
	plus-style = "syntax #c5cac6"
	minus-style = "syntax #e5d1be"
	plus-emph-style = "syntax #93a2a0"
	minus-emph-style = "syntax #d1b18f"
	zero-style = "syntax"
	file-style = "#b55264 bold"
	file-decoration-style = "#d5ccc6 ul"
	hunk-header-style = "file line-number syntax #ebe5e0"
	hunk-header-decoration-style = "#d5ccc6 box"
	hunk-header-line-number-style = "#845ec1"
	line-numbers-minus-style = "#a16405"
	line-numbers-plus-style = "#224a4b"
	line-numbers-zero-style = "#b8b3bd"
	line-numbers-left-style = "#b8b3bd"
	line-numbers-right-style = "#b8b3bd"
	commit-decoration-style = "#244a4b box"
	blame-palette = "#f0eae5 #eae4df #e3ddd8 #ddd7d2"
	merge-conflict-ours-diff-header-style = "#224a4b bold"
	merge-conflict-ours-diff-header-decoration-style = "#224a4b box"
	merge-conflict-theirs-diff-header-style = "#815fc3 bold"
	merge-conflict-theirs-diff-header-decoration-style = "#815fc3 box"
