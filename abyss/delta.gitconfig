# Abyss: Near-black and OLED-friendly, with clear accents that stand out without glowing.
# Generated by colorscheme-tools v0.1.0 from abyss/colorschemes.json. Do not edit.
# Usage: include this file in gitconfig; set delta.features = clearsight-abyss
# Set syntax-theme to any installed bat theme to customize syntax highlighting.

[delta "clearsight-abyss"]
	dark = "true"
	plus-style = "syntax #16273b"
	minus-style = "syntax #382d22"
	plus-emph-style = "syntax #1b4169"
	minus-emph-style = "syntax #694f2e"
	zero-style = "syntax"
	file-style = "#569da4 bold"
	file-decoration-style = "#282b30 ul"
	hunk-header-style = "file line-number syntax #16181c"
	hunk-header-decoration-style = "#282b30 box"
	hunk-header-line-number-style = "#d7a2ff"
	line-numbers-minus-style = "#f0a742"
	line-numbers-plus-style = "#1885e4"
	line-numbers-zero-style = "#40454d"
	line-numbers-left-style = "#40454d"
	line-numbers-right-style = "#40454d"
	commit-decoration-style = "#4d7ae6 box"
	blame-palette = "#121419 #17191d #1b1e22 #202227"
	merge-conflict-ours-diff-header-style = "#1885e4 bold"
	merge-conflict-ours-diff-header-decoration-style = "#1885e4 box"
	merge-conflict-theirs-diff-header-style = "#dfb8fe bold"
	merge-conflict-theirs-diff-header-decoration-style = "#dfb8fe box"
