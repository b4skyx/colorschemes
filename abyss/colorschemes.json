{
  "schema_version": 2,
  "id": "abyss",
  "name": "Abyss",
  "variant": "dark",
  "family": "abyss",
  "description": "Near-black and OLED-friendly, with clear accents that stand out without glowing.",
  "tags": [
    "dark",
    "near-black",
    "oled",
    "high-clarity"
  ],
  "designed_for": {
    "vision": "deutan",
    "severity": 1.0,
    "metric": "CIEDE2000 on simulated colours"
  },
  "palette": {
    "bg": "#0e1014",
    "bg_alt": "#15181d",
    "fg": "#c3c7ce",
    "fg_dim": "#80868f",
    "comment": "#5f6670",
    "indigo_dark": "#4d7ae6",
    "cyan_light": "#569da4",
    "yellow_dark": "#e6c77a",
    "teal_1": "#1ba871",
    "purple_1": "#d7a2ff",
    "blue_4": "#a7b8cd",
    "orange_light": "#bd7761",
    "yellow": "#fad54e",
    "blue_3": "#59b0ff",
    "teal_4": "#6fd6c3",
    "blue_2": "#1885e4",
    "purple_3": "#dfb8fe",
    "amber": "#f0a742",
    "orange_dark": "#c85c1f",
    "teal_2": "#2acc9a",
    "blue_1": "#097ddc",
    "purple_2": "#d8a4ff",
    "cyan_dark": "#2f8c85",
    "orange": "#d26c00",
    "teal_3": "#0ee0a0",
    "yellow_light": "#feec4e",
    "indigo_light": "#558af4",
    "purple_4": "#e9c6ff",
    "cyan": "#3a969b"
  },
  "roles": {
    "ui": {
      "bg": "bg",
      "bg_alt": "bg_alt",
      "fg": "fg",
      "fg_dim": "fg_dim",
      "comment": "comment"
    },
    "syntax": {
      "variable": {
        "fg": "ui.fg"
      },
      "comment": {
        "fg": "ui.comment",
        "italic": true
      },
      "keyword": {
        "fg": "indigo_dark"
      },
      "function": {
        "fg": "cyan_light"
      },
      "string": {
        "fg": "yellow_dark"
      },
      "type": {
        "fg": "teal_1"
      },
      "constant": {
        "fg": "purple_1"
      },
      "number": {
        "fg": "syntax.constant"
      },
      "boolean": {
        "fg": "syntax.constant"
      },
      "property": {
        "fg": "blue_4"
      },
      "parameter": {
        "fg": "ui.fg",
        "italic": true
      },
      "builtin": {
        "fg": "syntax.constant",
        "italic": true
      },
      "operator": {
        "fg": "ui.fg_dim"
      },
      "punctuation": {
        "fg": "ui.fg_dim"
      },
      "module": {
        "fg": "syntax.type",
        "italic": true
      },
      "attribute": {
        "fg": "syntax.keyword"
      },
      "tag": {
        "fg": "syntax.keyword"
      },
      "escape": {
        "fg": "syntax.constant"
      },
      "regex": {
        "fg": "syntax.constant"
      },
      "macro": {
        "fg": "syntax.keyword"
      },
      "constructor": {
        "fg": "syntax.type"
      },
      "label": {
        "fg": "syntax.keyword"
      },
      "todo": {
        "fg": "ui.bg",
        "bg": "diagnostic.warning",
        "bold": true
      },
      "note": {
        "fg": "ui.bg",
        "bg": "diagnostic.info",
        "bold": true
      }
    },
    "diagnostic": {
      "error": "orange_light",
      "warning": "yellow",
      "info": "blue_3",
      "hint": "teal_4",
      "ok": "git.add"
    },
    "git": {
      "add": "blue_2",
      "change": "purple_3",
      "delete": "amber"
    }
  },
  "terminal": {
    "background": "bg",
    "foreground": "fg",
    "cursor": "fg",
    "cursor_text": "bg",
    "selection_background": "bg_visual",
    "selection_foreground": "fg",
    "normal": {
      "black": {
        "raise": [
          "bg_alt",
          0.06
        ]
      },
      "red": "orange_dark",
      "green": "teal_2",
      "yellow": "yellow",
      "blue": "blue_1",
      "magenta": "purple_2",
      "cyan": "cyan_dark",
      "white": "fg"
    },
    "bright": {
      "black": "comment",
      "red": "orange",
      "green": "teal_3",
      "yellow": "yellow_light",
      "blue": "indigo_light",
      "magenta": "purple_4",
      "cyan": "cyan",
      "white": {
        "raise": [
          "fg",
          0.07
        ]
      }
    }
  }
}
